{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-atlas/process",
	"version": "0.1.0",
	"title": "Process",
	"category": "design",
	"icon": "editor-ol",
	"description": "Display a vertical timeline of sequential steps.",
	"keywords": [ "process", "timeline", "steps", "workflow" ],
	"attributes": {
		"circleColor": {
			"type": "string"
		},
		"circleTextColor": {
			"type": "string"
		},
		"lineColor": {
			"type": "string"
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
