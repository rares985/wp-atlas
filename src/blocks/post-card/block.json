{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-atlas/post-card",
	"version": "0.1.0",
	"title": "Post Card",
	"category": "common",
	"icon": "admin-post",
	"description": "Display a single post as a card with featured image, title, meta, excerpt, and read-more link.",
	"textdomain": "wp-atlas",
	"attributes": {
		"postId":            { "type": "number" },
		"showFeaturedImage": { "type": "boolean", "default": true },
		"showExcerpt":       { "type": "boolean", "default": true },
		"showDate":          { "type": "boolean", "default": true },
		"showAuthor":        { "type": "boolean", "default": false },
		"showCategory":      { "type": "boolean", "default": false },
		"excerptLength":     { "type": "number", "default": 20 },
		"titleLevel":        { "type": "number", "default": 3 },
		"buttonText":        { "type": "string", "default": "Read More" },
		"elevateOnHover":    { "type": "boolean", "default": false }
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"supports": {
		"html": false,
		"color": { "background": true, "text": true },
		"spacing": { "padding": true, "margin": true },
		"typography": { "fontSize": true },
		"__experimentalBorder": { "color": true, "radius": true, "width": true, "style": true }
	}
}
